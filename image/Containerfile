# Openfen OS
# Development preview 0.1
# Fedora 44 bootc foundation with GNOME

FROM quay.io/fedora/fedora-bootc:44

LABEL org.opencontainers.image.title="Openfen OS"
LABEL org.opencontainers.image.description="Open-source privacy-focused operating system"
LABEL org.opencontainers.image.version="0.1.0-dev"

# Install the GNOME desktop and essential applications
RUN dnf -y install \
    gdm \
    gnome-shell \
    gnome-session-wayland-session \
    gnome-control-center \
    nautilus \
    ptyxis \
    firefox \
    flatpak \
    plymouth \
    plymouth-scripts \
    plymouth-theme-spinner \
    && dnf clean all

# Replace Fedora release identity with a generic derivative foundation

RUN dnf -y swap fedora-release generic-release --allowerasing \
    && dnf clean all

# Apply Openfen system identity
COPY branding/os-release /usr/lib/os-release

# Enable GNOME graphical login
RUN systemctl enable --force gdm.service \
    && systemctl set-default graphical.target

# Openfen visual identity
RUN mkdir -p \
    /usr/share/backgrounds/openfen \
    /usr/share/pixmaps/openfen \
    /usr/share/gnome-background-properties

# Install official Openfen artwork
COPY branding/wallpapers/ /usr/share/backgrounds/openfen/
COPY branding/logos/ /usr/share/pixmaps/openfen/

# Register wallpapers in GNOME Settings
COPY branding/openfen-backgrounds.xml \
    /usr/share/gnome-background-properties/openfen.xml

# Apply GNOME desktop and login defaults
COPY branding/zz-openfen-wallpaper.gschema.override \
    /usr/share/glib-2.0/schemas/

COPY branding/zz-openfen-login.gschema.override \
    /usr/share/glib-2.0/schemas/

# Compile schemas once after all overrides
RUN glib-compile-schemas /usr/share/glib-2.0/schemas


# Openfen Plymouth boot splash
RUN mkdir -p /usr/share/plymouth/themes/openfen \
    /usr/lib/bootc/kargs.d \
    && cp -a /usr/share/plymouth/themes/spinner/. \
       /usr/share/plymouth/themes/openfen/ \
    && rm -f \
       /usr/share/plymouth/themes/openfen/spinner.plymouth \
       /usr/share/plymouth/themes/openfen/watermark.png \
       /usr/share/plymouth/themes/openfen/background-tile.png

COPY branding/plymouth/openfen.plymouth \
    /usr/share/plymouth/themes/openfen/openfen.plymouth

COPY branding/plymouth/watermark.png \
    /usr/share/plymouth/themes/openfen/watermark.png

COPY branding/plymouth/openfen-kargs.toml \
    /usr/lib/bootc/kargs.d/90-openfen-splash.toml

# Select Openfen's Plymouth theme
RUN plymouth-set-default-theme openfen

# Rebuild the image-embedded initramfs with Plymouth
RUN set -eu; \
    found=0; \
    for dir in /usr/lib/modules/*; do \
        [ -f "$dir/vmlinuz" ] || continue; \
        found=1; \
        kver="${dir##*/}"; \
        DRACUT_NO_XATTR=1 dracut --force \
            --no-hostonly --no-hostonly-cmdline \
            "$dir/initramfs.img" "$kver"; \
    done; \
    [ "$found" -eq 1 ]

# Validate the bootc image compatibility
RUN bootc container lint
